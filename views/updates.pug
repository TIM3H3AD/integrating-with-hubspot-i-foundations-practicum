doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        main.form-wrapper
            a(href="/") Return to the homepage
            h1 Create Extra Record
            p Use this form to create a Pinball Extra custom object record in HubSpot.

            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input#name(type="text" name="name" placeholder="Extra name" required)

                label(for="thing_id") Thing ID
                input#thing_id(type="text" name="thing_id" placeholder="313.cash thing ID" required)

                label(for="creator") Creator
                input#creator(type="text" name="creator" placeholder="Creator alias or ID" required)

                label(for="owner") Owner
                input#owner(type="text" name="owner" placeholder="Current owner alias or ID" required)

                label(for="ownership_id") Ownership ID
                input#ownership_id(type="text" name="ownership_id" placeholder="Pinball ownership ID" required)

                input(type="submit" value="Create Extra")
